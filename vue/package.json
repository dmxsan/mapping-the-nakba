{
  "name": "palestine-webgis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
"sync:data": "node -e \"const fs=require('fs'),p=require('path');['public/data','public/data/regions','public/data/borders'].forEach(d=>{try{fs.mkdirSync(p.join(__dirname,d),{recursive:true})}catch{}});fs.readdirSync(p.join(__dirname,'../data')).forEach(f=>{if(f.endsWith('.geojson'))fs.copyFileSync(p.join(__dirname,'../data',f),p.join(__dirname,'public/data',f))});fs.readdirSync(p.join(__dirname,'../data/regions')).forEach(f=>{if(f.endsWith('.geojson'))fs.copyFileSync(p.join(__dirname,'../data/regions',f),p.join(__dirname,'public/data/regions',f))});fs.readdirSync(p.join(__dirname,'../data/borders')).forEach(f=>{if(f.endsWith('.geojson'))fs.copyFileSync(p.join(__dirname,'../data/borders',f),p.join(__dirname,'public/data/borders',f))})",
    "predev": "npm run sync:data",
    "dev": "vite",
    "prebuild": "npm run sync:data",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fuse.js": "^7.0.0",
    "maplibre-gl": "^4.1.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
